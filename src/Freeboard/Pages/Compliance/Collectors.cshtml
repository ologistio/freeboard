@page "/settings/collectors"
@model Freeboard.Pages.Compliance.CollectorsModel
@{
    ViewData["Title"] = "Collector Register";
    ViewData["NavGroup"] = "Platform";
    ViewData["NavItem"] = "collectors";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold">Collector Register</h1>
    <p class="mt-1 text-sm text-muted">Controls, their evaluation rule, and the collectors attached to each - data sources, attestation forms, and training quizzes alike.</p>
</div>

@if (Model.StoreUnreachable)
{
    <p class="notice-error max-w-2xl">The compliance store could not be reached. Check the database connection.</p>
}
else if (Model.Controls.Count == 0)
{
    <p class="text-sm text-muted" data-empty>No controls are registered.</p>
}
else
{
    <div class="space-y-6">
        @foreach (var control in Model.Controls)
        {
            var collectors = Model.CollectorsFor(control.Id);
            <section class="card p-0" data-control-id="@control.Id">
                <div class="flex items-center justify-between gap-2 border-b border-neutral-200 px-4 py-3">
                    <div>
                        <h2 class="font-semibold">@control.Title</h2>
                        <p class="font-mono text-xs text-muted">@control.Id</p>
                    </div>
                    <span class="text-xs text-muted">
                        Evaluation:
                        <span class="badge badge-brand" data-evaluation>@Freeboard.Pages.Compliance.CollectorsModel.EvaluationLabel(control)</span>
                    </span>
                </div>
                @if (collectors.Count == 0)
                {
                    <p class="px-4 py-3 text-sm text-neutral-500" data-no-collectors>No collectors attached.</p>
                }
                else
                {
                    <div class="divide-y divide-neutral-100">
                        @foreach (var collector in collectors)
                        {
                            <div class="px-4 py-3" data-collector-id="@collector.Id">
                                <div class="flex items-center justify-between gap-2">
                                    <div>
                                        <span>@collector.Title</span>
                                        <span class="block font-mono text-xs text-neutral-500">@collector.Id</span>
                                    </div>
                                    <span class="badge badge-brand" data-type>@collector.Type</span>
                                </div>
                                <dl class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-xs text-muted">
                                    <div class="flex gap-1">
                                        <dt>Frequency:</dt>
                                        <dd data-frequency>@collector.Frequency</dd>
                                    </div>
                                    @if (!string.IsNullOrEmpty(collector.Provider))
                                    {
                                        <div class="flex gap-1">
                                            <dt>Provider:</dt>
                                            <dd class="font-mono" data-provider>@collector.Provider</dd>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(collector.Vendor))
                                    {
                                        <div class="flex gap-1">
                                            <dt>Vendor:</dt>
                                            <dd class="font-mono" data-vendor>@collector.Vendor</dd>
                                        </div>
                                    }
                                    @if (collector.Threshold is int threshold)
                                    {
                                        <div class="flex gap-1">
                                            <dt>Threshold:</dt>
                                            <dd data-threshold>@threshold%</dd>
                                        </div>
                                    }
                                </dl>
                                @if (!string.IsNullOrEmpty(collector.Config.Body))
                                {
                                    @* Body is authored markdown rendered as HTML-encoded text: a git-authored *@
                                    @* body must never become live HTML (stored-XSS). No @@Html.Raw, no markdown step. *@
                                    <p class="mt-2 whitespace-pre-line text-sm text-neutral-700" data-body>@collector.Config.Body</p>
                                }
                                @if (collector.Config.Fields.Count > 0)
                                {
                                    <ul class="mt-2 space-y-1 text-sm" data-fields>
                                        @foreach (var field in collector.Config.Fields)
                                        {
                                            <li data-field-id="@field.Id">
                                                <span>@field.Label</span>
                                                <span class="font-mono text-xs text-neutral-500" data-field-type>[@field.Type]</span>
                                                @if (field.Options.Count > 0)
                                                {
                                                    <span class="text-xs text-neutral-500" data-field-options>(@string.Join(", ", field.Options))</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (collector.Config.PassMark is int passMark)
                                {
                                    <p class="mt-2 text-sm text-neutral-700">Pass mark: <span data-pass-mark>@passMark%</span></p>
                                }
                                @if (collector.Config.Quiz.Count > 0)
                                {
                                    <ul class="mt-2 space-y-1 text-sm" data-quiz>
                                        @foreach (var item in collector.Config.Quiz)
                                        {
                                            <li data-quiz-id="@item.Id">
                                                <span data-quiz-prompt>@item.Prompt</span>
                                                <span class="text-xs text-neutral-500" data-quiz-options>(@string.Join(", ", item.Options))</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (collector.Config.Checks.Count > 0)
                                {
                                    <ul class="mt-2 space-y-1 text-sm" data-checks>
                                        @foreach (var check in collector.Config.Checks)
                                        {
                                            <li data-check-name="@check.Name">
                                                <span>@check.Name</span>
                                                <span class="font-mono text-xs text-neutral-500" data-check-severity>[@check.Severity]</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
}
