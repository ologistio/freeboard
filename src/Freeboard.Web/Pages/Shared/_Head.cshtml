<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - Freeboard</title>
@if (ViewData["Description"] is string description)
{
    <meta name="description" content="@description" />
}
@* Pre-launch: the copy is still placeholder, so keep the site out of search results.
   At launch, remove this AND wwwroot/robots.txt - either one left behind keeps the
   site deindexed. *@
<meta name="robots" content="noindex, nofollow" />
<link rel="stylesheet" href="/css/app.css" />
@* Runs before first paint so a dark reader never sees a light flash. Theme is an
   explicit choice, as in the app: no system preference is read. *@
<script>
    (function () {
        var stored = null;
        try { stored = localStorage.getItem("fb-theme"); } catch (e) { }
        document.documentElement.setAttribute("data-theme", stored === "dark" ? "dark" : "light");
        window.fbToggleTheme = function () {
            var dark = document.documentElement.getAttribute("data-theme") !== "dark";
            document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
            try { localStorage.setItem("fb-theme", dark ? "dark" : "light"); } catch (e) { }
        };
    })();
</script>
<script src="/js/app.js" defer></script>
